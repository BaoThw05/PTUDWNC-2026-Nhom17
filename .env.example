# Sao chép thành .env (không commit .env). docker compose tự đọc file này.

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=culinary_blog
POSTGRES_USER=culinary_admin
POSTGRES_PASSWORD=change_me_dev_password
# Cổng chung của nhóm là 5432. Chỉ đổi khi máy đã bị chiếm cổng, và ghi vào README mục 3.1.
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=change_me_dev_password

# ── Backend API ─────────────────────────────────────────────
# .NET không tự đọc file .env. Nếu đổi giá trị ở trên, đặt connection string bằng
# biến môi trường hoặc user-secrets (xem README mục 3.1):
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;Port=5433;..." --project src/Backend/CulinaryBlog.API
API_URL=http://localhost:5000
