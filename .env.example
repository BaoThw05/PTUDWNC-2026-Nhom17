# Sao chép thành .env (không commit .env). docker compose tự đọc file này.

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=CulinaryBlogDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
# Cổng chung của cả nhóm, không đổi.
POSTGRES_PORT=5432
APP_PORT=80
AUTH_SECRET=change_me_to_a_random_secret_of_at_least_32_characters
AUTH_URL=http://localhost
HANGFIRE_USER=admin
HANGFIRE_PASSWORD=change_me_hangfire_password

# Chỉ dùng cho profile demo. Lấy token của remotely-managed Tunnel từ Cloudflare.
# Giữ trống khi chạy local; không commit token thật.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=change_me_dev_password
REDIS_PORT=6379

# ── Object Storage (MinIO) ───────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=culinary-blog
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Observability và email development ───────────────────────
SEQ_ADMIN_PASSWORD=change_me_seq_password
SEQ_PORT=5341
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── Backend API ─────────────────────────────────────────────
# .NET không tự đọc file .env. Nếu đổi mật khẩu ở trên, đặt connection string bằng
# user-secrets (xem README mục 2):
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;Port=5432;...;Password=<mật khẩu>" --project src/Backend/CulinaryBlog.API
API_URL=http://localhost:5000
