# Sao chép thành .env.local (không commit .env.local lên git).

NEXT_PUBLIC_API_URL=http://localhost:5165

# openssl rand -base64 32
AUTH_SECRET=change_me_generate_a_long_random_base64_string

# Tạo OAuth Client (Web application) ở Google Cloud Console, thêm Authorized
# redirect URI: http://localhost:3000/api/auth/callback/google
# Backend cũng cần đúng Client ID này ở appsettings Google:ClientId.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
