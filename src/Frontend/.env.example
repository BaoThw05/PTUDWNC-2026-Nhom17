# Sao chép thành .env.local (không commit .env.local).

# Backend mà server Next.js gọi tới (rewrite /api/* và fetch phía server).
API_INTERNAL_URL=http://localhost:5000

# Tiền tố URL API phía trình duyệt. Để trống = gọi /api/* cùng origin qua rewrite.
NEXT_PUBLIC_API_BASE_URL=

# ── Auth.js ─────────────────────────────────────────────────
# Khóa mã hóa cookie phiên. Ở máy dev có thể để trống (dùng khóa dev có sẵn);
# production bắt buộc đặt: npx auth secret  (hoặc openssl rand -base64 32)
AUTH_SECRET=

# Đăng nhập Google (tùy chọn — để trống thì ẩn nút Google).
# Tạo OAuth Client (Web application) trên Google Cloud Console, thêm Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
# Backend cần cùng Client ID ở Authentication:Google:ClientId.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
