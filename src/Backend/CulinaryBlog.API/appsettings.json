{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "Provider": "Local",
    "PublicBaseUrl": "/media",
    "LocalRootPath": "storage"
  }
}
